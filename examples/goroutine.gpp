package main

import (
	"fmt"
	"sync"
	"time"
)

class Worker {
	private id int

	constructor(id int) {
		this.id = id
	}

	public function Run(jobs <-chan int, results chan<- string, wg *sync.WaitGroup) {
		defer wg.Done()
		for j := range jobs {
			results <- fmt.Sprintf("worker %d finished job %d", this.id, j)
		}
	}
}

function main() {
	jobs := make(chan int, 10)
	results := make(chan string, 10)
	var wg sync.WaitGroup

	for i := 1; i <= 3; i++ {
		wg.Add(1)
		go new Worker(i).Run(jobs, results, &wg)
	}
	for j := 1; j <= 5; j++ {
		jobs <- j
	}
	close(jobs)
	wg.Wait()
	close(results)

	count := 0
	for range results {
		count++
	}
	fmt.Println("jobs done:", count)

	timeout := make(chan bool)
	select {
	case v := <-timeout:
		fmt.Println(v)
	case <-time.After(10 * time.Millisecond):
		fmt.Println("timeout")
	}
}
